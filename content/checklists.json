      "items": [
        { "id": "ck_visit_01", "text": "실제 주소·동호수가 등기부·건축물대장과 일치하는지 확인", "required": true, "helpLessonId": "ls_03_01", "allowPhoto": true },
        { "id": "ck_visit_02", "text": "우편함·현관 고지서로 다른 세대 거주·체납 흔적 확인", "required": false, "allowPhoto": true },
        { "id": "ck_visit_03", "text": "누수·곰팡이·결로·수압·보일러 상태 확인(사진·영상)", "required": true, "allowPhoto": true },
